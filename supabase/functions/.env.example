# Copy to supabase/functions/.env for local Supabase CLI only.
# In production set these as Supabase project secrets (Dashboard → Edge Functions → Secrets).
# Never put these values in Vite / frontend env files.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Preferred AI provider
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=https://www.equitylabs.online
OPENROUTER_FALLBACK_MODEL=qwen/qwen3-vl-8b-thinking

# Optional fallbacks
LOVABLE_API_KEY=

# Payments (server only)
STRIPE_SECRET_KEY=
# Price IDs de los planes (crear en Stripe Dashboard → Products & Prices)
STRIPE_PRICE_TACTICAL=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_MASTERMIND=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_ALLIANCE=
# Se genera al crear el webhook endpoint en Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=
